# --- Database (Supabase or local Postgres) ---
# Async driver, used by the app
DATABASE_URL=postgresql+asyncpg://postgres:<PASSWORD>@<HOST>:5432/postgres
# Sync driver, used by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg://postgres:<PASSWORD>@<HOST>:5432/postgres

# --- Auth ---
# Any long random string. Generate one, don't reuse this placeholder.
JWT_SECRET_KEY=change_me_to_a_long_random_string

# Session cookie. For a cross-site deployment (frontend and API on different domains)
# set COOKIE_SECURE=true and COOKIE_SAMESITE=none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- CORS ---
# Comma-separated list of allowed frontend origins.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Used to build links in verification and password reset emails.
FRONTEND_URL=http://localhost:5173

# --- Email (optional) ---
# Leave SMTP_HOST empty in development: emails are printed to the backend console instead.
#
# Gmail (free, good for MVP — no domain needed):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your.address@gmail.com
#   SMTP_PASSWORD=<16-character App Password, not your Google password>
#   SMTP_FROM=DronaAI.fit <your.address@gmail.com>   (must match SMTP_USER)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DronaAI.fit <no-reply@dronaai.fit>
