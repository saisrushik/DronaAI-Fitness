# --- Database (Supabase or local Postgres) ---
# Async driver, used by the app
DATABASE_URL=postgresql+asyncpg://postgres:<PASSWORD>@<HOST>:5432/postgres?ssl=require
# Sync driver, used by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg://postgres:<PASSWORD>@<HOST>:5432/postgres?sslmode=require
# Local development only: set when your network blocks port 5432 but has an HTTP proxy.
# OUTBOUND_PROXY=http://proxy.example.com:80

# Set to production on the deployed API; unsafe settings then stop it from starting.
ENVIRONMENT=development

# --- Auth ---
# Any long random string. Generate one, don't reuse this placeholder.
JWT_SECRET_KEY=change_me_to_a_long_random_string

# Session cookie. For a cross-site deployment (frontend and API on different domains)
# set COOKIE_SECURE=true and COOKIE_SAMESITE=none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- CORS ---
# Comma-separated list of allowed frontend origins.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
